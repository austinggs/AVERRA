# Copy to .env.local and fill in. NEVER commit .env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Absolute origin of the deployed site, no trailing slash required.
# Used to build shareable referral links. REQUIRED: the referral page reads this through
# validated env and fails loudly if it is missing, because a relative link earns nobody
# once it is pasted into a chat app.
#
# DECLARED EXACTLY ONCE. There used to be a second bare `NEXT_PUBLIC_SITE_URL=` line
# directly below this one, adding a duplicate declaration of the same variable. That is
# not a harmless redundancy: dotenv resolves a duplicate key to the LAST occurrence, so
# the empty line silently overrode the example above it. Every operator who copied this
# file to .env.local got an empty site URL - which is exactly the dead referral link the
# comment above warns about, reintroduced by the file meant to prevent it.
# See docs/DISCREPANCIES.md Q-63.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# server-only: never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
CELO_CHAIN_ID=42220
CELO_RPC_URL=
# deposit token allowlist (contract addresses supplied by ops after RPC verification)
DEPOSIT_TOKEN_USDT_CONTRACT=
DEPOSIT_TOKEN_USDC_CONTRACT=
DEPOSIT_TOKEN_USDM_CONTRACT=
DEPOSIT_TOKEN_USAT_CONTRACT=
# shared secret for the internal outbox worker endpoint (never expose publicly)
#
# REQUIRED IN THE PRODUCTION DEPLOYMENT ENVIRONMENT, not just locally.
# `vercel.json` schedules POST /api/internal/outbox/drain every five minutes, and
# that route returns 503 and processes nothing when this variable is unset. The
# failure is silent from the outside - a 503-per-run looks exactly like an empty
# queue - which is how thirteen outbox events sat at `attempts: 0` with no visible
# symptom. Nothing moves money either way: handlers produce notifications only,
# and the financial state that emitted the event is already committed.
#
# Vercel cron does NOT attach this header for you. The secret must be a real
# environment variable on the deployment.
OUTBOX_WORKER_SECRET=
# shared secret for provider callback signature verification (per deployment, never committed)
PROVIDER_CALLBACK_SECRET=

# --- CPX Research (LIVE since migration 065) --------------------------------
# Both values come from the CPX publisher dashboard (publisher.cpx-research.com).
# Neither may be prefixed with NEXT_PUBLIC_. CPX_SECURE_HASH is the vendor's shared
# secret: it signs the INBOUND postback (md5(trans_id + '-' + secret)) and the
# OUTBOUND entry link (md5(ext_user_id + '-' + secret)). One secret, two formulas.
CPX_APP_ID=
CPX_SECURE_HASH=

# --- Adsterra (banner ads, REVENUE ONLY) ------------------------------------
# Ad impressions only. These variables are NOT a provider integration: Adsterra has no
# row in app.providers, is not registered in src/lib/providers/registry.ts, and can
# never produce a reward, a ledger entry or a withdrawal. Do not wire an ad impression
# into the reward path.
#
# The NEXT_PUBLIC_ prefix is CORRECT here and is not the SUPABASE_SECRET_KEY mistake.
# An Adsterra zone key is a public client identifier that appears in the HTML of every
# page showing the ad. It authorizes nothing against our systems. A server-only value
# would force us to proxy ad markup through our own origin for no security benefit.
#
# Paste BOTH values per zone VERBATIM from the Adsterra publisher dashboard. The script
# URL is deliberately NOT hardcoded anywhere in the source: during CR-0039 four
# independent attempts to read Adsterra's loader URL from their documentation failed
# (JavaScript-rendered pages plus search-engine bot challenges), and a guessed host in
# a CSP `script-src` blocks the ad silently while the page looks perfectly healthy.
#
# The CSP derives its allowlist from these SCRIPT values via adDeliveryOrigins(), so
# you never edit next.config.ts. Changing a zone URL changes the policy automatically.
# With every value unset the ad subsystem is inert and renders nothing.
NEXT_PUBLIC_ADSTERRA_NATIVE_KEY=
NEXT_PUBLIC_ADSTERRA_NATIVE_SCRIPT=
NEXT_PUBLIC_ADSTERRA_300X250_KEY=
NEXT_PUBLIC_ADSTERRA_300X250_SCRIPT=
NEXT_PUBLIC_ADSTERRA_320X50_KEY=
NEXT_PUBLIC_ADSTERRA_320X50_SCRIPT=
NEXT_PUBLIC_ADSTERRA_728X90_KEY=
NEXT_PUBLIC_ADSTERRA_728X90_SCRIPT=